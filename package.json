{
  "name": "mcp-digisac",
  "version": "0.1.0",
  "description": "MCP server for Digisac - connect AI assistants to Digisac REST API via MCP protocol",
  "type": "module",
  "bin": {
    "mcp-digisac": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/unit/*.test.mjs tests/e2e/*.test.mjs",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
